{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manhaji/storyboard",
  "title": "Motion · line-anchored storyboard",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-G(0[7-9]|1[0-2])-U[0-9]{2}-L[0-9]{2}(-[A-Z0-9]+)?$"
    },
    "script_version": {
      "type": "integer"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "central_visual_idea": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "recurring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations_to_show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "real_to_abstract_moment": {
          "type": "string"
        },
        "confusion_treatments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "central_visual_idea",
        "elements",
        "environment",
        "recurring",
        "changing",
        "relations_to_show",
        "real_to_abstract_moment",
        "confusion_treatments"
      ]
    },
    "world": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reused_from": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kit",
        "description"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "section": {
            "enum": [
              "hook",
              "context",
              "bridge",
              "explanation",
              "demonstration",
              "conclusion"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2}[a-z]?$"
            }
          },
          "silent_duration_sec": {
            "type": "number",
            "minimum": 0
          },
          "goal": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "desc": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "desc"
              ]
            }
          },
          "on_screen_text": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "beat": {
                  "type": "string"
                },
                "style": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          },
          "motion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "beat": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                },
                "before": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "holds": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "beat",
                "what",
                "why",
                "result"
              ]
            }
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "line": {
                      "type": "string",
                      "pattern": "^L[0-9]{2}[a-z]?$"
                    },
                    "scene": {
                      "type": "string"
                    },
                    "at": {
                      "oneOf": [
                        {
                          "enum": [
                            "start",
                            "end"
                          ]
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ]
                    },
                    "word": {
                      "type": "string"
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false,
                  "required": []
                },
                "offset": {
                  "type": "number"
                },
                "purpose": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "anchor"
              ]
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "beat": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "offset": {
                  "type": "number"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.5
                }
              },
              "additionalProperties": false,
              "required": [
                "beat",
                "name"
              ]
            }
          },
          "transition_out": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "type"
            ]
          },
          "silent_tail_sec": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "section",
          "lines",
          "goal",
          "elements",
          "motion",
          "beats",
          "transition_out"
        ]
      },
      "minItems": 3
    },
    "revision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "change",
          "reason",
          "requested_by"
        ]
      }
    },
    "music": {
      "type": "boolean",
      "description": "false = no music bed (SFX + voice only)"
    },
    "music_track": {
      "type": "string",
      "description": "music file under engine/public (e.g. music/upbeat.wav)"
    }
  },
  "additionalProperties": false,
  "required": [
    "episode_id",
    "script_version",
    "analysis",
    "world",
    "scenes"
  ]
}