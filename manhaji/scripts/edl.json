  "segments": [
    {"id": "story",    "in": 1.80,  "out": 10.32, "gap": 0.55, "text": "كنت أصوّر وفجأة انقطعت الكهرباء… كل اللمبات طفت إلا واحدة، لأنها تشتغل بالكهرباء أو البطارية الاحتياطية"},
    {"id": "question", "in": 31.15, "out": 36.15, "gap": 0.65, "text": "طيب وش الفرق لو قلت: اللمبة تشتغل بالكهرباء والبطارية الاحتياطية؟"},
    {"id": "logic",    "in": 37.05, "out": 44.20, "gap": 0.55, "text": "هنا يدخل درس المنطق. في المنطق، الجملة اللي نقدر نحكم عليها بصح أو خطأ نسمّيها عبارة"},
    {"id": "example",  "in": 44.90, "out": 46.80, "gap": 0.40, "text": "مثلًا في الموقف اللي قبل شوي"},
    {"id": "pQ",       "in": 60.82, "out": 62.05, "gap": 0.30, "text": "الكهرباء شغّالة؟"},
    {"id": "pNo",      "in": 62.45, "out": 62.85, "gap": 0.25, "text": "لا"},
    {"id": "pF",       "in": 63.26, "out": 64.86, "gap": 0.60, "text": "نحطها في مصطلح False"},
    {"id": "qQ",       "in": 67.26, "out": 69.20, "gap": 0.30, "text": "البطارية الاحتياطية شغّالة؟"},
    {"id": "qYes",     "in": 70.17, "out": 70.56, "gap": 0.25, "text": "نعم"},
    {"id": "qT",       "in": 71.17, "out": 72.62, "gap": 0.75, "text": "نحطها في مصطلح True"},
    {"id": "or",       "in": 73.30, "out": 78.42, "gap": 0.50, "text": "لما أقول: الكهرباء شغّالة أو البطارية شغّالة… هذه عبارة فصل"},
    {"id": "and",      "in": 78.80, "out": 84.50, "gap": 0.55, "text": "لكن لو قلت: الكهرباء شغّالة والبطارية شغّالة… فهنا كلامي خطأ"},
    {"id": "andName",  "in": 86.88, "out": 88.30, "gap": 0.10, "text": "هذه عبارة وصل"},
    {"id": "waw",      "in": 90.30, "out": 91.85, "gap": 0.90, "text": "لتواجد حرف الواو"},
    {"id": "venn",     "in": 98.90, "out": 102.88,"gap": 3.40, "text": "ونقدر نوضّح الفرق بشكل أبسط من خلال أشكال فن"},
    {"id": "outro",    "in": 107.20,"out": 111.90,"gap": 0.45, "text": "باقي التفاصيل في درس المنطق، من مادة الرياضيات للصف الأول ثانوي"},
    {"id": "salam",    "in": 112.45,"out": 113.45,"gap": 0.00, "text": "السلام عليكم"}
