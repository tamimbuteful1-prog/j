{
  "name": "manhaji-logic",
  "version": "1.0.0",
  "private": true,
  "description": "منهجي — المنطق | Cinematic motion graphics lesson (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "sfx": "node scripts/generate-sfx.mjs",
    "render": "remotion render ManhajiLogic out/manhaji-logic.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "render:draft": "remotion render ManhajiLogic out/draft.mp4 --codec=h264 --crf=28 --scale=0.5",
    "still": "remotion still ManhajiLogic out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.3"
  }
}
