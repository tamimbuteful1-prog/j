{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manhaji/lesson_analysis",
  "title": "Writer · lesson analysis",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-G(0[7-9]|1[0-2])-U[0-9]{2}-L[0-9]{2}(-[A-Z0-9]+)?$"
    },
    "status": {
      "enum": [
        "ok",
        "blocked"
      ]
    },
    "blocked_reason": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "semester": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "lesson": {
          "type": "string"
        },
        "official_title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "unit",
        "lesson",
        "official_title"
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "enum": [
              "book",
              "inferred"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "source",
          "page"
        ]
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "source": {
            "enum": [
              "book",
              "inferred"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "term",
          "definition",
          "source",
          "page"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "enum": [
              "book",
              "inferred"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "source",
          "page"
        ]
      }
    },
    "book_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "summary",
          "solution",
          "page"
        ]
      }
    },
    "prior_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "enum": [
              "book",
              "inferred"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "source",
          "page"
        ]
      }
    },
    "difficulty_point": {
      "type": "string"
    },
    "core_concept": {
      "type": "string"
    },
    "learning_gap": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "minLength": 10
        },
        "after": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ]
    },
    "split_suggestion": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "episode_id",
    "status",
    "meta",
    "objectives",
    "terms",
    "rules",
    "misconceptions",
    "difficulty_point",
    "core_concept",
    "learning_gap"
  ]
}