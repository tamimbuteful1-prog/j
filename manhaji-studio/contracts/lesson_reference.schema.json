{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manhaji/lesson_reference",
  "title": "Lesson reference (created by the orchestrator from the book index)",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-G(0[7-9]|1[0-2])-U[0-9]{2}-L[0-9]{2}(-[A-Z0-9]+)?$"
    },
    "subject": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "semester": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "unit_title": {
      "type": "string"
    },
    "lesson": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "book": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "pages"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "episode_id",
    "subject",
    "grade",
    "unit",
    "lesson",
    "title",
    "book"
  ]
}