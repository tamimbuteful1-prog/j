{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manhaji/agent_result",
  "title": "Structured result every agent run returns",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "done",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_reason": {
      "type": "string"
    },
    "needs_human": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "outputs"
  ]
}