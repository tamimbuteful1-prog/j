{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manhaji/book_index",
  "title": "Book index (lessons + pages) extracted from a textbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "subject",
    "grade",
    "units",
    "status"
  ],
  "properties": {
    "book_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "semester": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "blocked"
      ]
    },
    "notes": {
      "type": "string"
    },
    "page_offset": {
      "type": "integer",
      "description": "PDF page index minus printed page number"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "title",
          "lessons"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lesson",
                "title",
                "page_from",
                "page_to",
                "readable"
              ],
              "properties": {
                "lesson": {
                  "type": "string",
                  "pattern": "^[0-9]{2}$"
                },
                "title": {
                  "type": "string"
                },
                "page_from": {
                  "type": "integer"
                },
                "page_to": {
                  "type": "integer"
                },
                "readable": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}